# AeroE connector configuration (copy to .env and `set -a; . ./.env; set +a` or use your service manager)
PORT=8790
OPERATOR_NAME="Example Charter Pty Ltd"
# pilotId:token pairs; the app sends the token as a Bearer header. "*:token" allows any pilot ID.
AEROE_TOKENS=P42:changeme-long-random-token,P43:another-token
# The app's origin for CORS (the GitHub Pages site or your own host)
ALLOWED_ORIGIN=https://swalksa350.github.io
# NAIPS account used for briefings and flight plan filing (register at https://www.airservicesaustralia.com/naips/)
NAIPS_USER=YOURNAIPSID
NAIPS_PASS=yourpassword
NAIPS_SOURCE=aeroe
# Optional: plain-English briefing summaries written by Claude (https://platform.claude.com)
# ANTHROPIC_API_KEY=sk-ant-...
# AEROE_SUMMARY_MODEL=claude-opus-5-5
# Where roster.json, fleet.json, notices.json and records/ live
DATA_DIR=./data
